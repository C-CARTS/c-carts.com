{
	"author": "MTD",
	"bugs": {
		"url": "https://github.com/C-CARTS/c-carts.com/issues"
	},
	"contributors": [
		{
			"name": "Ryan Blackman",
			"url": "https://github.com/rblackman"
		}
	],
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/node": "^24.19.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-check-updates": "^23.1.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": "24.x"
	},
	"name": "c-carts",
	"private": true,
	"repository": "github:C-CARTS/c-carts.com",
	"scripts": {
		"build": "pnpm typegen && pnpm --filter @c-carts/site build && pnpm --filter @c-carts/cms build",
		"dev": "pnpm typegen && pnpm --parallel --filter @c-carts/site --filter @c-carts/cms dev",
		"dev:site": "pnpm typegen && pnpm --filter @c-carts/site dev",
		"dev:cms": "pnpm --filter @c-carts/cms dev",
		"check": "biome check .",
		"lint": "pnpm check",
		"format": "biome check --write .",
		"typegen": "pnpm --filter @c-carts/cms typegen && pnpm --filter @c-carts/site typegen",
		"typecheck": "tsc --noEmit && pnpm -r typecheck",
		"test": "pnpm --filter @c-carts/site test && pnpm --filter @c-carts/cms test",
		"ci:verify": "pnpm typegen && pnpm check && pnpm typecheck && pnpm test",
		"clean": "pnpm -r clean",
		"prepare": "husky",
		"start": "pnpm --filter @c-carts/site start",
		"update:check": "npm-check-updates --deep --reject @types/node",
		"update:install": "npm-check-updates --deep -u --reject @types/node"
	},
	"type": "module",
	"version": "2.1.0",
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
